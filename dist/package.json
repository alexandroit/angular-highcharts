{
  "name": "@stackline/angular-highcharts",
  "version": "22.1.5",
  "description": "Angular wrapper components for Highcharts, Highstock, Highmaps, zAxis, and colorAxis integrations",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/angular-highcharts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stackline",
    "npm-package",
    "angular-highcharts",
    "angular",
    "typescript",
    "angular22",
    "angular-22",
    "angular-library",
    "charts",
    "highcharts",
    "highcharts-angular",
    "chart-wrapper",
    "ui-component",
    "wrapper",
    "library",
    "highstock",
    "highmaps",
    "coloraxis",
    "zaxis",
    "maintained"
  ],
  "author": "Alexandro Paixao Marques",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "bugs": {
    "url": "https://github.com/alexandroit/angular-highcharts/issues"
  },
  "homepage": "https://alexandro.net/docs/angular/angular-highcharts/",
  "peerDependencies": {
    "@angular/core": ">=22.0.0 <24.0.0",
    "highcharts": ">=5.0.0 <=13.0.2"
  },
  "dependencies": {
    "tslib": "npm:@stackline/tslib@1.0.0"
  },
  "module": "fesm2022/stackline-angular-highcharts.mjs",
  "typings": "types/stackline-angular-highcharts.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/stackline-angular-highcharts.d.ts",
      "default": "./fesm2022/stackline-angular-highcharts.mjs"
    }
  },
  "type": "module",
  "main": "fesm2022/stackline-angular-highcharts.mjs",
  "es2022": "fesm2022/stackline-angular-highcharts.mjs",
  "esm2022": "fesm2022/stackline-angular-highcharts.mjs",
  "fesm2022": "fesm2022/stackline-angular-highcharts.mjs",
  "types": "types/stackline-angular-highcharts.d.ts"
}
