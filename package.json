{
  "name": "@stackline/angular-highcharts",
  "version": "22.1.5",
  "description": "Angular wrapper components for Highcharts, Highstock, Highmaps, zAxis, and colorAxis integrations",
  "sideEffects": false,
  "scripts": {
    "test:fixtures": "node tools/stackline-run-release-smoke.mjs --catalog",
    "watch": "tsc -w",
    "build": "ng-packagr -p ng-package.json && node scripts/finalize-package.mjs",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.tests.json && node --test .stackline-build/unit-tests/tests/*.test.js",
    "test:browser": "node scripts/verify-live-docs.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "npm test && npm run build && npm run pack:check && npm run test:package",
    "docs:install:angular-4": "node scripts/run-compat-doc-line.mjs install angular-4",
    "build:docs:angular-4": "node scripts/run-compat-doc-line.mjs build angular-4",
    "docs:install:angular-5": "node scripts/run-compat-doc-line.mjs install angular-5",
    "build:docs:angular-5": "node scripts/run-compat-doc-line.mjs build angular-5",
    "docs:install:angular-6": "node scripts/run-compat-doc-line.mjs install angular-6",
    "build:docs:angular-6": "node scripts/run-compat-doc-line.mjs build angular-6",
    "docs:install:angular-7": "node scripts/run-compat-doc-line.mjs install angular-7",
    "build:docs:angular-7": "node scripts/run-compat-doc-line.mjs build angular-7",
    "docs:install:angular-8": "node scripts/run-compat-doc-line.mjs install angular-8",
    "build:docs:angular-8": "node scripts/run-compat-doc-line.mjs build angular-8",
    "docs:install:angular-9": "node scripts/run-compat-doc-line.mjs install angular-9",
    "build:docs:angular-9": "node scripts/run-compat-doc-line.mjs build angular-9",
    "docs:install:angular-10": "node scripts/run-compat-doc-line.mjs install angular-10",
    "build:docs:angular-10": "node scripts/run-compat-doc-line.mjs build angular-10",
    "docs:install:angular-11": "node scripts/run-compat-doc-line.mjs install angular-11",
    "build:docs:angular-11": "node scripts/run-compat-doc-line.mjs build angular-11",
    "docs:install:angular-12": "node scripts/run-compat-doc-line.mjs install angular-12",
    "build:docs:angular-12": "node scripts/run-compat-doc-line.mjs build angular-12",
    "docs:install:angular-13": "node scripts/run-compat-doc-line.mjs install angular-13",
    "build:docs:angular-13": "node scripts/run-compat-doc-line.mjs build angular-13",
    "docs:install:angular-14": "node scripts/run-compat-doc-line.mjs install angular-14",
    "build:docs:angular-14": "node scripts/run-compat-doc-line.mjs build angular-14",
    "docs:install:angular-15": "node scripts/run-compat-doc-line.mjs install angular-15",
    "build:docs:angular-15": "node scripts/run-compat-doc-line.mjs build angular-15",
    "docs:install:angular-16": "node scripts/run-compat-doc-line.mjs install angular-16",
    "build:docs:angular-16": "node scripts/run-compat-doc-line.mjs build angular-16",
    "docs:install:angular-17": "node scripts/run-compat-doc-line.mjs install angular-17",
    "build:docs:angular-17": "node scripts/run-compat-doc-line.mjs build angular-17",
    "docs:install:angular-18": "node scripts/run-compat-doc-line.mjs install angular-18",
    "build:docs:angular-18": "node scripts/run-compat-doc-line.mjs build angular-18",
    "docs:install:angular-19": "node scripts/run-compat-doc-line.mjs install angular-19",
    "build:docs:angular-19": "node scripts/run-compat-doc-line.mjs build angular-19",
    "docs:install:angular-20": "node scripts/run-compat-doc-line.mjs install angular-20",
    "build:docs:angular-20": "node scripts/run-compat-doc-line.mjs build angular-20",
    "docs:install:angular-21": "node scripts/run-compat-doc-line.mjs install angular-21",
    "build:docs:angular-21": "node scripts/run-compat-doc-line.mjs build angular-21",
    "docs:install:angular-22": "cd docs-src/angular-22 && npm install --ignore-scripts",
    "sync:docs:angular-22": "node scripts/sync-angular-22-package.mjs",
    "build:docs:angular-22": "npm run sync:docs:angular-22 && npm --prefix docs-src/angular-22 run build && node scripts/sync-angular-22-docs-output.mjs",
    "build:docs": "npm run build:docs:angular-22",
    "serve:docs": "http-server docs -p 8080 -c-1",
    "test:docs:candidate": "node scripts/install-docs-candidate.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/angular-highcharts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stackline",
    "npm-package",
    "angular-highcharts",
    "angular",
    "typescript",
    "angular22",
    "angular-22",
    "angular-library",
    "charts",
    "highcharts",
    "highcharts-angular",
    "chart-wrapper",
    "ui-component",
    "wrapper",
    "library",
    "highstock",
    "highmaps",
    "coloraxis",
    "zaxis",
    "maintained"
  ],
  "author": "Alexandro Paixao Marques",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "bugs": {
    "url": "https://github.com/alexandroit/angular-highcharts/issues"
  },
  "homepage": "https://alexandro.net/docs/angular/angular-highcharts/",
  "peerDependencies": {
    "@angular/core": ">=22.0.0 <24.0.0",
    "highcharts": ">=5.0.0 <=13.0.2"
  },
  "devDependencies": {
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/core": "22.1.3",
    "@types/node": "22.20.1",
    "highcharts": "13.0.2",
    "http-server": "npm:@stackline/http-server@1.0.0",
    "ng-packagr": "22.1.1",
    "puppeteer-core": "25.8.0",
    "rxjs": "^7.8.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "tslib": "npm:@stackline/tslib@1.0.0"
  },
  "overrides": {
    "ng-packagr": {
      "tslib": "$tslib"
    }
  }
}
