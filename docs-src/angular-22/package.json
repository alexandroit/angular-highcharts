    "@angular/router": "22.2.4",
    "@stackline/angular-highcharts": "22.1.9",
    "highcharts": "13.1.1",
    "rxjs": "7.8.2",
    "tslib": "npm:@stackline/tslib@1.1.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "overrides": {
